# ──────────────────────────────────────────────────────────────
# Neon Postgres — TWO URLs required.
#   DATABASE_URL          → pooled,   for Next.js serverless runtime
#                           (used by @neondatabase/serverless)
#   DATABASE_URL_UNPOOLED → direct,   for drizzle-kit migrations
#                           (pooled URLs time out on long migration txns)
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/autoride?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/autoride?sslmode=require"

# ──────────────────────────────────────────────────────────────
# Gemini embeddings — phase 03. Free tier is enough.
# Get a key at https://aistudio.google.com/app/apikey.
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="ai-studio-key-here"

# ──────────────────────────────────────────────────────────────
# Agent SDK auth — phase 05. Set EXACTLY ONE of the three paths
# below. Precedence if multiple are set: API key > gateway > OAuth.
# Full decision tree: docs/roadmap/ROADMAP.md → "Auth for the Agent SDK".
#
# Path 1 — Pro/Max subscription OAuth (cleanest for this non-commercial build).
#   Generate via `claude setup-token` in a Claude Code session.
# CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-xxxxxxxxxxxx"
#
# Path 2 — Gateway / LiteLLM Max-passthrough proxy.
#   Run LiteLLM locally with Max pass-through; the SDK sees only a
#   bearer-token gateway — resilient to future SDK auth-precedence changes.
# ANTHROPIC_BASE_URL="http://localhost:4000"
# ANTHROPIC_AUTH_TOKEN="sk-litellm-master-key"
#
# Path 3 — Direct API key from console.anthropic.com.
#   Required if Auto-ride ever turns commercial; otherwise optional.
# ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxx"
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────
# Phase 09 — nightly cleanup
# Set to 'false' to disable the cleanup cron without redeploying.
# Manual trigger via `pnpm cleanup:run-once` always works regardless.
# ──────────────────────────────────────────────────────────────
MEMORY_CLEANUP_CRON_ENABLED=true

# ──────────────────────────────────────────────────────────────
# Phase 10 — operator dashboard
# Name shown in the <Greeting /> headline ("Hi {OPERATOR_NAME},").
# ──────────────────────────────────────────────────────────────
OPERATOR_NAME=Shahriar

# ──────────────────────────────────────────────────────────────
# Phase 11 — Better Auth + SSE token gate.
# Generate the two secrets with `openssl rand -hex 32` (32-byte hex).
# Use SEPARATE values: BETTER_AUTH_SECRET signs the session cookie,
# SSE_TOKEN_SECRET signs the short-lived `?token=` on EventSource.
# ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="replace-me-32-bytes-hex"
BETTER_AUTH_URL="http://localhost:3100"
SSE_TOKEN_SECRET="replace-me-32-bytes-hex"
# Optional kill-switch — set to '1' to refuse new sign-ups at /register.
# BETTER_AUTH_SIGNUP_DISABLED=1

# ──────────────────────────────────────────────────────────────
# Later phases will append:
#   INNGEST_EVENT_KEY         (phase 06)
#   INNGEST_SIGNING_KEY       (phase 06)
#   LANGFUSE_PUBLIC_KEY       (phase 12)
#   LANGFUSE_SECRET_KEY       (phase 12)
#   LANGFUSE_BASEURL          (phase 12)
# ──────────────────────────────────────────────────────────────
